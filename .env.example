# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get this from your Apify account integration settings
APIFY_API_TOKEN=your_apify_token_here

# The long ID from your Google Sheet URL
SPREADSHEET_ID=your_google_sheet_id_here

# Minimum score to export to Google Sheets (max 102)
SCORE_THRESHOLD=40

# Your compensation band, annual total comp in USD (e.g. 180000).
# COMP_FLOOR also drives the salary pre-filter; leave it blank to turn that filter off.
COMP_FLOOR=
COMP_TARGET=
COMP_TOP=
